# native f32 playback device over miniaudio's ma_device layer
#
# this is the only module that crosses into native code. it binds the vendored
# miniaudio device shim (vendor/mad.c, miniaudio v0.11.25) and nothing else:
# open a device, start/stop it, close it, and query the active format. the shim
# exposes a small, ABI-stable `mad_*` surface, so miniaudio's own struct layouts
# never reach Mach and a miniaudio bump cannot break this binding. everything
# above the callback - mixing, decoding, resampling - is the pure-mach layer.
#
# REAL-TIME CONTRACT. the render callback runs on a separate, high-priority OS
# thread owned by the audio backend. it must not allocate, take a lock, block,
# or do I/O; it must only fill the output buffer and return promptly. missing a
# deadline drops audio. filling from preallocated sources (audio.mix) or a
# decoded Buffer (audio.stream) satisfies this; anything that can page-fault,
# wait on a mutex, or call the allocator does not.
#
# LINKING. a program that opens a device inherits the vendored shim build, local
# runtime archives, and target-filtered system/framework links from mach.toml.
# those requirements cascade to consumers; the pure-mach layer links nothing.

use std.types.error.err;
use std.types.result.res;

use audio.buffer;

# a device render callback: fill out with frame_count interleaved f32 frames of
# channels samples each, then return. invoked on the audio thread under the
# real-time contract documented above.
# ---
# out:         interleaved f32 output, frame_count * channels samples, overwritten
# frame_count: number of frames requested this call
# channels:    interleaved channel count (matches the opened Format)
# user:        the opaque pointer passed to open
pub def RenderFn: fun(*f32, u32, u32, ptr);

# open an f32 playback device into out; 0, a negative ma_result, or MAD_NULL_BACKEND
ext fun mad_device_open(sample_rate: u32, channels: u32, render: RenderFn, user: ptr, out: *ptr) i32;

# mad_device_open's status when only the null backend could be opened
val MAD_NULL_BACKEND: i32 = 1;

# start the device's audio thread; 0 on success
ext fun mad_device_start(dev: ptr) i32;

# stop the device's audio thread; 0 on success
ext fun mad_device_stop(dev: ptr) i32;

# stop and release the device and its handle
ext fun mad_device_close(dev: ptr);

# the active sample rate the callback is fed
ext fun mad_device_sample_rate(dev: ptr) u32;

# the active channel count the callback is fed
ext fun mad_device_channels(dev: ptr) u32;

# why a device operation refused
# ---
# channels:    the requested format declares zero channels
# render:      the render callback is nil
# closed:      the device is not open
# unavailable: no real output backend is available, only miniaudio's null backend
# backend:     the backend refused, with miniaudio's negative ma_result code
pub tag DeviceError: u8 {
    channels;
    render;
    closed;
    unavailable;
    backend: i32;
}

# an open playback device driven by a render callback
# ---
# handle: opaque shim-owned device handle, nil once closed
pub rec Device {
    handle: ptr;
}

# open an f32 output device for the given format, driven by render
#
# the device starts stopped; call start to begin playback. the callback is fed
# interleaved f32 at the active format, which may differ from the request when
# the backend cannot honor it exactly - query sample_rate and channels after
# opening and convert source material to match (audio.resample / audio.mix).
# ---
# format: requested rate and channel layout; channels must be >= 1
# render: callback invoked on the audio thread to fill output (see RenderFn)
# user:   opaque pointer handed back to every render call
# ret:    an open Device, or why none could be opened
pub fun open(format: buffer.Format, render: RenderFn, user: ptr) res[Device, DeviceError] {
    if (format.channels == 0) { ret res[Device, DeviceError].err{DeviceError.channels{}}; }
    if (render == nil)        { ret res[Device, DeviceError].err{DeviceError.render{}}; }

    var h:      ptr = nil;
    val status: i32 = mad_device_open(format.sample_rate, format.channels::u32, render, user, ?h);
    if (status == MAD_NULL_BACKEND) { ret res[Device, DeviceError].err{DeviceError.unavailable{}}; }
    if (status != 0)                { ret res[Device, DeviceError].err{DeviceError.backend{status}}; }

    var d: Device;
    d.handle = h;
    ret res[Device, DeviceError].ok{d};
}

# start playback: the audio thread begins calling render
# ---
# dev: an open device
# ret: ok, or closed when the device is not open, or the backend's refusal
pub fun start(dev: *Device) err[DeviceError] {
    if (dev == nil || dev.handle == nil) { ret err[DeviceError].err{DeviceError.closed{}}; }
    val status: i32 = mad_device_start(dev.handle);
    if (status != 0) { ret err[DeviceError].err{DeviceError.backend{status}}; }
    ret err[DeviceError].ok{};
}

# stop playback: render stops being called; the device stays open and restartable
# ---
# dev: an open device
# ret: ok, or closed when the device is not open, or the backend's refusal
pub fun stop(dev: *Device) err[DeviceError] {
    if (dev == nil || dev.handle == nil) { ret err[DeviceError].err{DeviceError.closed{}}; }
    val status: i32 = mad_device_stop(dev.handle);
    if (status != 0) { ret err[DeviceError].err{DeviceError.backend{status}}; }
    ret err[DeviceError].ok{};
}

# close the device and release its handle
# ---
# dev: a device to close; safe to call more than once (the handle is cleared)
pub fun close(dev: *Device) {
    if (dev == nil) { ret; }
    if (dev.handle != nil) {
        mad_device_close(dev.handle);
        dev.handle = nil;
    }
}

# the rate, in Hz, the device feeds the callback
# ---
# dev: an open device
# ret: the active sample rate, or 0 if the device is closed
pub fun sample_rate(dev: Device) u32 {
    if (dev.handle == nil) { ret 0; }
    ret mad_device_sample_rate(dev.handle);
}

# the channel count the device feeds the callback
# ---
# dev: an open device
# ret: the active channel count, or 0 if the device is closed
pub fun channels(dev: Device) u16 {
    if (dev.handle == nil) { ret 0; }
    ret mad_device_channels(dev.handle)::u16;
}

test open__refuses_invalid_requests {
    var fmt: buffer.Format;
    fmt.sample_rate = 48000;
    fmt.channels    = 0;
    val none: res[Device, DeviceError] = open(fmt, silent, nil);
    if (!(sel none.err && sel none.err.channels)) { ret 1; }

    fmt.channels = 2;
    val unset: res[Device, DeviceError] = open(fmt, nil, nil);
    if (!(sel unset.err && sel unset.err.render)) { ret 2; }

    var closed: Device;
    closed.handle = nil;
    val started: err[DeviceError] = start(?closed);
    if (!(sel started.err && sel started.err.closed)) { ret 3; }
    val stopped: err[DeviceError] = stop(?closed);
    if (!(sel stopped.err && sel stopped.err.closed)) { ret 4; }
    close(?closed);
    ret 0;
}

# a render callback that leaves the output untouched
#[testing]
fun silent(out: *f32, frames: u32, channels: u32, user: ptr) {}
