# the flat public surface of the mach-audio library
#
# re-exports every public symbol of the split modules under one namespace so a
# bare `use audio;` reaches the whole API as audio.gain(), audio.sum(),
# audio.clamp(). the split modules (audio.mix, ...) remain importable on their
# own for smaller dependency surfaces.

use audio.buffer;
# aliased so the flattened `mix` function does not collide with the module name.
use mixer: audio.mix;
use audio.resample;
use audio.wav;
use audio.stream;
use audio.device;
# links the startup entrypoint so `mach test` over this library produces a binary.
use std.runtime;

fwd buffer.Format;
fwd buffer.Buffer;
fwd buffer.init;
fwd buffer.dnit;
fwd buffer.sample_count;
fwd buffer.at;

fwd mixer.unity;
fwd mixer.silence;
fwd mixer.gain;
fwd mixer.sum;
fwd mixer.clamp;
fwd mixer.Source;
fwd mixer.apply_gain;
fwd mixer.clamp_samples;
fwd mixer.mix_add;
fwd mixer.mix_add_pan;
fwd mixer.mix;
fwd mixer.mono_to_stereo;
fwd mixer.stereo_to_mono;

fwd resample.resample_frame_count;
fwd resample.resample_linear;

fwd wav.decode;

fwd stream.Stream;
fwd stream.stream_over;
fwd stream.stream_set_rate;
fwd stream.RATE_MIN;
fwd stream.RATE_MAX;
fwd stream.pull;
fwd stream.done;

fwd device.RenderFn;
fwd device.Device;
fwd device.open;
fwd device.start;
fwd device.stop;
fwd device.close;
fwd device.sample_rate;
fwd device.channels;
