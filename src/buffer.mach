# the pcm currency of the pure-mach layer
#
# the pure layer works in interleaved, normalized f32 samples nominally in
# [-1.0, 1.0]. a Format describes how a flat sample stream is laid out (rate and
# channel count); a Buffer owns one such stream. the future device layer hands
# this type up and takes it back, nothing here touches the device.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use allo: std.allocator;
use page: std.allocator.page;

# the interpretation of an interleaved f32 sample stream
# ---
# sample_rate: frames per second (e.g. 44100)
# channels:    interleaved channel count (1 = mono, 2 = stereo)
pub rec Format {
    sample_rate: u32;
    channels:    u16;
}

# an owning, interleaved f32 sample buffer
#
# samples holds frames * channels values in channel-interleaved order; release
# it with dnit.
# ---
# alloc:   allocator backing samples
# format:  rate and channel layout
# frames:  number of frames (samples per channel)
# samples: interleaved sample storage, owned (nil when frames is 0)
pub rec Buffer {
    alloc:   *allo.Allocator;
    format:  Format;
    frames:  usize;
    samples: *f32;
}

# why a Buffer could not be allocated
# ---
# channels: the format declares zero channels
# overflow: frames * channels does not fit usize
# alloc:    the allocator refused, including a nil allocator as invalid
pub tag BufferError: u8 {
    channels;
    overflow;
    alloc: allo.Error;
}

# allocate a zeroed Buffer of the given frame count
# ---
# a:      allocator to back the sample storage
# format: rate and channel layout; channels must be >= 1
# frames: number of frames to allocate
# ret:    a zeroed Buffer, or why it could not be allocated
pub fun init(a: *allo.Allocator, format: Format, frames: usize) res[Buffer, BufferError] {
    if (format.channels == 0) {
        ret res[Buffer, BufferError].err{BufferError.channels{}};
    }

    val ch: usize = format.channels::usize;
    if (frames > (~(0::usize)) / ch) {
        ret res[Buffer, BufferError].err{BufferError.overflow{}};
    }
    val total: usize = frames * ch;

    val storage: res[*f32, allo.Error] = allo.zallocate[f32](a, total);
    if (sel storage.err) {
        ret res[Buffer, BufferError].err{BufferError.alloc{storage.err}};
    }

    var buf: Buffer;
    buf.alloc   = a;
    buf.format  = format;
    buf.frames  = frames;
    buf.samples = storage.ok;
    ret res[Buffer, BufferError].ok{buf};
}

# free the sample storage and reset the buffer to empty
#
# a refused release leaves the buffer owning its storage.
# ---
# buf: buffer to release; nil is a no-op
# ret: ok once the storage is released, or the allocator's refusal
pub fun dnit(buf: *Buffer) err[allo.Error] {
    if (buf == nil) { ret err[allo.Error].ok{}; }

    val released: err[allo.Error] = allo.deallocate[f32](buf.alloc, buf.samples, sample_count(@buf));
    if (sel released.err) { ret released; }
    buf.samples = nil;
    buf.frames  = 0;
    ret released;
}

# total interleaved samples in the buffer (frames * channels)
# ---
# buf: buffer to query
# ret: number of f32 samples in buf.samples
pub fun sample_count(buf: Buffer) usize {
    ret buf.frames * (buf.format.channels::usize);
}

# pointer to the sample for a given frame and channel, bounds-checked
# ---
# buf:     buffer to index
# frame:   frame index (0 .. frames-1)
# channel: channel index (0 .. channels-1)
# ret:     pointer to the sample, or none when buf is nil or either index is out of range
pub fun at(buf: *Buffer, frame: usize, channel: usize) opt[*f32] {
    if (buf == nil) { ret opt[*f32].none{}; }
    val ch: usize = buf.format.channels::usize;
    if (frame >= buf.frames || channel >= ch) {
        ret opt[*f32].none{};
    }
    ret opt[*f32].some{?buf.samples[frame * ch + channel]};
}

# true when a release completed. test fixture
fun released(r: err[allo.Error]) bool {
    ret sel r.ok;
}

test "buffer: init allocates zeroed interleaved storage" {
    var a: allo.Allocator;
    page.make(?a);

    var fmt: Format;
    fmt.sample_rate = 48000;
    fmt.channels    = 2;

    val made: res[Buffer, BufferError] = init(?a, fmt, 4);
    if (sel made.err) { ret 1; }
    var buf: Buffer = made.ok;

    if (buf.frames != 4) { ret 1; }
    if (sample_count(buf) != 8) { ret 1; }
    if (buf.format.sample_rate != 48000) { ret 1; }

    var i: usize = 0;
    for (i < 8) {
        if (buf.samples[i] != 0.0) { ret 1; }
        i = i + 1;
    }

    if (!released(dnit(?buf))) { ret 1; }
    ret 0;
}

test "buffer: at bounds-checks frame and channel" {
    var a: allo.Allocator;
    page.make(?a);

    var fmt: Format;
    fmt.sample_rate = 44100;
    fmt.channels    = 2;

    val made: res[Buffer, BufferError] = init(?a, fmt, 3);
    if (sel made.err) { ret 1; }
    var buf: Buffer = made.ok;

    val in_range: opt[*f32] = at(?buf, 2, 1);
    if (sel in_range.none) { ret 1; }
    @in_range.some = 0.5;
    if (buf.samples[2 * 2 + 1] != 0.5) { ret 1; }

    val past_frame: opt[*f32] = at(?buf, 3, 0);
    if (sel past_frame.some) { ret 1; }
    val past_channel: opt[*f32] = at(?buf, 0, 2);
    if (sel past_channel.some) { ret 1; }

    if (!released(dnit(?buf))) { ret 1; }
    ret 0;
}

test "buffer: zero channels is rejected" {
    var a: allo.Allocator;
    page.make(?a);

    var fmt: Format;
    fmt.sample_rate = 44100;
    fmt.channels    = 0;

    val made: res[Buffer, BufferError] = init(?a, fmt, 8);
    if (!(sel made.err && sel made.err.channels)) { ret 1; }
    ret 0;
}

test "buffer: an overflowing sample count is rejected" {
    var a: allo.Allocator;
    page.make(?a);

    var fmt: Format;
    fmt.sample_rate = 44100;
    fmt.channels    = 2;

    val made: res[Buffer, BufferError] = init(?a, fmt, ~(0::usize));
    if (!(sel made.err && sel made.err.overflow)) { ret 1; }
    ret 0;
}

test "buffer: zero frames allocates nothing and dnit is a noop" {
    var a: allo.Allocator;
    page.make(?a);

    var fmt: Format;
    fmt.sample_rate = 22050;
    fmt.channels    = 1;

    val made: res[Buffer, BufferError] = init(?a, fmt, 0);
    if (sel made.err) { ret 1; }
    var buf: Buffer = made.ok;
    if (sample_count(buf) != 0) { ret 1; }
    if (buf.samples != nil) { ret 1; }
    if (!released(dnit(?buf))) { ret 1; }
    ret 0;
}

test "buffer: nil allocator is rejected" {
    var fmt: Format;
    fmt.sample_rate = 44100;
    fmt.channels    = 2;

    val made: res[Buffer, BufferError] = init(nil, fmt, 4);
    if (!(sel made.err && (sel made.err.alloc && sel made.err.alloc.invalid))) { ret 1; }
    ret 0;
}
