# decode a WAV file, mix it, and play it on the default output device
#
# the end-to-end path the library exists for: read bytes -> audio.decode (pure
# WAV) -> audio.mix (pure mixer) -> audio.stream + audio.open (device). run it
# from the repository root with `mach run demo/play -- file.wav`.
# needs a machine with an audio device; it cannot run in headless CI.
#
# the mixing is done once on the main thread into a device-format buffer, and
# the audio thread only pulls from that finished buffer - so the render callback
# never allocates or locks, honoring the real-time contract in audio.device.

use std.collections.vector.Vector;
use std.runtime;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use audio;
use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use fs: std.filesystem;
use std.print;
use std.system.os;

# audio-thread render callback: pull the next frames from the borrowed Stream.
# real-time safe - no allocation, no locks (audio.stream.pull guarantees it).
fun render(out: *f32, frames: u32, channels: u32, user: ptr) {
    audio.pull(user:~*audio.Stream, out, frames, channels);
}

# the name of the case a failure holds, for a one-line diagnostic
fun case_name[T](value: T) str {
    $each case in $cases(T) {
        if (sel value.[case]) { ret case.name; }
    }
    ret "unknown";
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) {
        print.eprintln("usage: play <file.wav>");
        ret 2;
    }
    val path: str = argv[1]::str;

    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) {
        print.eprintlnf("cannot create allocator: {}", case_name[allo.Error](made.err));
        ret 1;
    }

    val rf: res[Vector[u8], fs.FsError] = fs.read_bytes(?a, path);
    if (sel rf.err) {
        print.eprintlnf("cannot read {}: {}", path, case_name[fs.FsError](rf.err));
        ret 1;
    }
    var bytes: Vector[u8] = rf.ok;

    val rd: res[audio.Buffer, audio.DecodeError] = audio.decode(?a, bytes.data, bytes.len);
    vector.dnit[u8](?bytes);
    if (sel rd.err) {
        print.eprintlnf("cannot decode {}: {}", path, case_name[audio.DecodeError](rd.err));
        ret 1;
    }
    var src: audio.Buffer = rd.ok;

    # mix the decoded source into a device-format buffer (one source at unity
    # gain; more sources plug in the same way).
    val ro: res[audio.Buffer, audio.BufferError] = audio.init(?a, src.format, src.frames);
    if (sel ro.err) {
        print.eprintlnf("cannot allocate the mix: {}", case_name[audio.BufferError](ro.err));
        ret 1;
    }
    var out: audio.Buffer = ro.ok;

    var sources: [1]audio.Source;
    sources[0].samples = src.samples;
    sources[0].gain    = audio.unity;
    audio.mix(out.samples, audio.sample_count(out), ?sources[0], 1);

    var s: audio.Stream = audio.stream_over(?out, false);

    val rdev: res[audio.Device, audio.DeviceError] = audio.open(out.format, render, (?s):~ptr);
    if (sel rdev.err) {
        print.eprintlnf("cannot open device: {}", case_name[audio.DeviceError](rdev.err));
        ret 1;
    }
    var dev: audio.Device = rdev.ok;

    print.printlnf("playing {} ({} Hz, {} ch, {} frames)",
        path, out.format.sample_rate, out.format.channels::u32, out.frames::u32);

    val rstart: err[audio.DeviceError] = audio.start(?dev);
    if (sel rstart.err) {
        print.eprintlnf("cannot start device: {}", case_name[audio.DeviceError](rstart.err));
        audio.close(?dev);
        ret 1;
    }

    # play for the source duration plus a short tail so the device buffer drains.
    val dur_ns: i64 = (out.frames::i64) * 1000000000 / (out.format.sample_rate::i64);
    os.sleep(dur_ns + 300000000);

    audio.stop(?dev);
    audio.close(?dev);
    audio.dnit(?out);
    audio.dnit(?src);
    ret 0;
}
